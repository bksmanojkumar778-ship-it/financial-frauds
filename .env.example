# QuantumShield Finance - Environment Configuration Template
# Research & Hackathon Prototype

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (PostgreSQL for production; SQLite fallback for local dev)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quantumshield_db
DATABASE_URL=sqlite:///./quantumshield.db

# Security & Secrets
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_in_production
ALLOWED_HOSTS=127.0.0.1,localhost

# Fraud Detection Engine Parameters
BASELINE_AMOUNT_THRESHOLD=5000.0
RISK_REVIEW_THRESHOLD=50.0
RISK_HOLD_THRESHOLD=75.0
RISK_DECLINE_THRESHOLD=85.0

# Post-Quantum Cryptography Parameters
PQC_ALGORITHM_KEM=ML-KEM-768
PQC_ALGORITHM_DSA=ML-DSA-65
SYMMETRIC_ALGORITHM=AES-256-GCM
KEY_VERSION=qsf-pqc-2026-v1

# Synthetic Dataset Seeds
RANDOM_SEED=42
